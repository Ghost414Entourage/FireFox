<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Don't allow sites to see your location -->
    <key>DefaultGeolocationSetting</key>
    <integer>2</integer>

    <!-- Don't allow sites to use your camera -->
    <key>DefaultVideoCaptureSetting</key>
    <integer>2</integer>

    <!-- Don't allow sites to use your microphone -->
    <key>DefaultAudioCaptureSetting</key>
    <integer>2</integer>

    <!-- Don't allow sites to send notifications -->
    <key>DefaultNotificationsSetting</key>
    <integer>2</integer>

    <!-- Don't allow sites to use motion sensors -->
    <key>DefaultSensorsSetting</key>
    <integer>2</integer>

    <!-- Don't allow sites to automatically download multiple files -->
    <key>DefaultAutomaticDownloadsSetting</key>
    <integer>2</integer>

    <!-- Block sites from autoplaying videos -->
    <key>AutoplayAllowed</key>
    <false/>

    <!-- Don't allow legacy Google Sign-In via third-party cookies -->
    <key>DefaultGoogleSignInSetting</key>
    <integer>2</integer>

    <!-- Disable Brave AI Chat (Leo) -->
    <key>BraveAIChatEnabled</key>
    <false/>

    <!-- Disable Brave Wallet and block site access to Ethereum, Solana, and Cardano provider APIs -->
    <key>BraveWalletDisabled</key>
    <true/>

    <!-- Don't allow sites to handle protocols -->
    <key>DefaultProtocolHandlerSetting</key>
    <integer>2</integer>

    <!-- Don't allow sites to control and reprogram MIDI devices -->
    <key>DefaultMidiSetting</key>
    <integer>2</integer>

    <!-- Don't allow sites to connect to USB devices -->
    <key>DefaultUsbGuardSetting</key>
    <integer>2</integer>

    <!-- Don't allow sites to connect to serial ports -->
    <key>DefaultSerialGuardSetting</key>
    <integer>2</integer>

    <!-- Don't allow sites to edit files or folders on your device -->
    <key>DefaultFileSystemWriteGuardSetting</key>
    <integer>2</integer>

    <!-- Don't allow sites to connect to HID devices -->
    <key>DefaultWebHidGuardSetting</key>
    <integer>2</integer>

    <!-- Don't allow sites to see text or images on your clipboard -->
    <key>DefaultClipboardSetting</key>
    <integer>2</integer>

    <!-- Don't allow sites to install payment handlers -->
    <key>DefaultPaymentHandlerSetting</key>
    <integer>2</integer>

    <!-- Don't allow sites to create a 3D map of your surroundings or track camera position -->
    <key>WebXRImmersiveArEnabled</key>
    <false/>

    <!-- Don't allow sites to use virtual reality devices or data -->
    <key>WebXRImmersiveVrEnabled</key>
    <false/>

    <!-- Don't allow sites to manage windows on all your displays -->
    <key>DefaultWindowManagementSetting</key>
    <integer>2</integer>

    <!-- Don't allow sites to use fonts installed on your device -->
    <key>DefaultLocalFontsSetting</key>
    <integer>2</integer>

    <!-- Don't allow sites to enter picture-in-picture automatically -->
    <key>AutoPictureInPictureEnabled</key>
    <false/>

    <!-- Don't allow sites to scroll and zoom shared tabs -->
    <key>DefaultCapturedSurfaceControlSetting</key>
    <integer>2</integer>

    <!-- Don't allow sites to install web apps on your device -->
    <key>WebAppInstallByUserEnabled</key>
    <false/>

    <!-- Don't allow sites to access other devices on your local network -->
    <key>LocalNetworkAccessBlockedForUrls</key>
    <array>
        <string>*</string>
    </array>

    <!-- Don't allow sites to access other apps and services on this device -->
    <key>DefaultAppsOnDeviceSetting</key>
    <integer>2</integer>

    <!-- Delete data sites have saved to your device when you close all windows -->
    <key>DefaultCookiesSetting</key>
    <integer>4</integer>
</dict>
</plist>




---------------------------------------------------------------------------------------------------------------------------



sudo mkdir -p /Library/Managed\ Preferences/
sudo nano /Library/Managed\ Preferences/com.brave.Browser.plist

sudo chmod 644 /Library/Managed\ Preferences/com.brave.Browser.plist
sudo chown root:wheel /Library/Managed\ Preferences/com.brave.Browser.plist
